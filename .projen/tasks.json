{
  "manifestVersion": 3,
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)",
        "HEAD_COMMIT": "$(git rev-parse --short HEAD)"
      },
      "steps": [
        {
          "exec": "git checkout -B \"scratch-$HEAD_COMMIT\"",
          "name": "save current HEAD in a \"scratch-<commit>\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under a \"scratch-<commit>\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile"
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "npx -y -p ts-node@10.9.2 -p typescript@6.0.3 ts-node --project tsconfig.projen.json .projenrc.ts"
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package"
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "publish:maven-central": {
      "name": "publish:maven-central",
      "description": "Sign and upload to Maven Central (needs the release profile secrets)",
      "steps": [
        {
          "exec": "mvn -B deploy -P release"
        }
      ]
    },
    "publish:maven-central:dry-run": {
      "name": "publish:maven-central:dry-run",
      "description": "Build and sign with the release profile; uploads nothing",
      "steps": [
        {
          "exec": "mvn -B verify -P release"
        }
      ]
    },
    "release:version": {
      "name": "release:version",
      "description": "Compute the next release version from the commits since the last tag",
      "steps": [
        {
          "exec": "node node_modules/@xpertss/projen-types/lib/java/release-version.js --baseline 3.0.0 --min-major 3"
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "exec": "mvn -B verify"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "steps": [
        {
          "exec": "mvn -B org.codehaus.mojo:versions-maven-plugin:2.22.0:display-dependency-updates org.codehaus.mojo:versions-maven-plugin:2.22.0:display-plugin-updates"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
